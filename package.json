{
  "name": "agent-race",
  "version": "0.1.0",
  "description": "Replay Claude Code and Codex sessions on a 3D map of your repo, solo or side by side.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrashnaLabs/agent-race.git"
  },
  "homepage": "https://github.com/PrashnaLabs/agent-race#readme",
  "bugs": {
    "url": "https://github.com/PrashnaLabs/agent-race/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "visualization",
    "three.js",
    "session-replay"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "packageManager": "pnpm@12.18.0",
  "bin": {
    "agent-race": "src/cli.ts"
  },
  "scripts": {
    "race": "node src/cli.ts view",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test src/ viewer/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
